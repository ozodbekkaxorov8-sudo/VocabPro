# Docker Compose needs strong, unique values for these settings.
# Use URL-safe characters for the PostgreSQL password when DATABASE_URL contains it.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
SESSION_SECRET=
TEACHER_CODE=

APP_ORIGIN=http://127.0.0.1:3000
SECURE_COOKIES=false
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
# Optional managed database override for the API.
# DATABASE_URL=postgresql://vocabpro:password@db:5432/vocabpro
# Optional Telegram integration.
TELEGRAM_BOT_TOKEN=
